# Leave EMPTY in development: Vite proxies /api and /socket.io to http://localhost:5000.
# In production set this to your deployed backend URL, e.g. https://campusbite-api.onrender.com
VITE_API_URL=
VITE_API_BASE_URL=

# Socket.io URL — leave EMPTY in dev (proxied). In production same as VITE_API_URL.
VITE_SOCKET_URL=

# Razorpay public key (safe to expose in the browser). Get from Razorpay Dashboard.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
