# ───────────── Server ─────────────
PORT=5000
NODE_ENV=development
# Frontend origin(s) allowed by CORS + Socket.io. Comma-separated for several.
CLIENT_URL=http://localhost:5173

# ───────────── NeonDB (https://console.neon.tech) ─────────────
# Pooled connection (host contains "-pooler") -> used by the app at runtime
DATABASE_URL="postgresql://neondb_owner:npg_6NmjqVCitnS7@ep-calm-hall-b5w6l5y1-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct connection (same string WITHOUT "-pooler") -> used by Prisma for schema push/migrations
DIRECT_URL="postgresql://neondb_owner:npg_6NmjqVCitnS7@ep-calm-hall-b5w6l5y1.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ───────────── Auth ─────────────
# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ───────────── Razorpay (https://dashboard.razorpay.com) ─────────────
# Use test keys in development (prefix: rzp_test_), live keys in production (prefix: rzp_live_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ───────────── Canteen settings (served to the frontend via /api/v1/config) ─────────────
DELIVERY_FEE=10
TABLE_COUNT=20
HOSTEL_BLOCKS=Boys Hostel Block A,Boys Hostel Block B,Girls Hostel Block A,Girls Hostel Block B

# ───────────── Seed accounts (used by: npm run db:seed) ─────────────
ADMIN_NAME=Canteen Admin
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin@12345
RUNNER_NAME=Delivery Runner
RUNNER_EMAIL=runner@campus.edu
RUNNER_PASSWORD=Runner@12345
